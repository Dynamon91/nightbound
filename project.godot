config_version=5

[application]
config/name="Nightbound"
run/main_scene="res://scenes/main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/shadow_atlas/size=4096
lights_and_shadows/directional_shadow/max_distance=80.0

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
burst={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70)]}
echosense={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
shadow_dash={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
save_game={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":80)]}
load_game={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":79)]}
